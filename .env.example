DATABASE_URL=postgresql://postgres:secret@localhost:5433/ej

# Set to your server's IP/domain so Better Auth works from other devices
BETTER_AUTH_URL=http://localhost:3000

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=redissecret

BETTER_AUTH_SECRET=betterauthsecret

NEXT_PUBLIC_TURNSTILE_SITE_KEY=publickey
TURNSTILE_SECRET_KEY=secretkey

# Generate with: pnpm generate:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your@email.com

# Telegram bot for bug reports (get token from @BotFather, chat ID from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
