# Copy to .env and set a password:  cp .env.example .env

# --- database -------------------------------------------------------------
# Deliberately different from kbpej (which uses ej on port 5433), so both
# projects can run at the same time without colliding.
POSTGRES_USER=ejdemo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ej_demo
POSTGRES_PORT=5434

# Used by the app and by the Prisma CLI on your machine.
# Inside Docker the host is `postgres`; from your machine it is localhost.
DATABASE_URL=postgresql://ejdemo:change-me@localhost:5434/ej_demo

# --- app ------------------------------------------------------------------
APP_PORT=8080

# Where record attachments are written.
UPLOAD_DIR=./uploads
