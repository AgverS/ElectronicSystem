    "db:reset": "tsx prisma/seed.ts --reset",
    "db:studio": "prisma studio",
    "check:demo-db": "tsx lib/demo-db/verify.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
